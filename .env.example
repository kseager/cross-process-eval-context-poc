# Microsoft Foundry project endpoint
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name (or set FOUNDRY_MODEL_NAME)
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Evaluation group reused across run-poc executions (created automatically)
FOUNDRY_EVAL_GROUP_ID=

# Application Insights connection string (traces sink here for BOTH processes)
APPLICATIONINSIGHTS_CONNECTION_STRING=

# true to capture prompts/responses in traces (dev/test only)
ENABLE_SENSITIVE_DATA=false

# URL of the separate agent-service process
AGENT_SERVICE_URL=http://localhost:8002/invoke
